{
  "name": "mundaai",
  "version": "1.0.0",
  "description": "the backend engine for the mundaAI service",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "d1:migrate:local": "wrangler d1 migrations apply mundaai --local",
    "d1:migrate:remote": "wrangler d1 migrations apply mundaai --remote",
    "deploy": "wrangler deploy",
    "pages:deploy": "pnpm --dir website exec vite build && wrangler pages deploy website/dist --project-name mundaai --branch main --commit-dirty=true"
  },
  "keywords": [],
  "author": "Farirai Masocha",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "wrangler": "^4.135.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
