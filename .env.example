PORT=3000

# From `pnpm exec wrangler whoami` and `pnpm exec wrangler d1 create mundaai`.
CLOUDFLARE_ACCOUNT_ID=
# API token with D1 Read and D1 Write. https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# crop.health key from https://crop.kindwise.com (header Api-Key)
KINDWISE_API_KEY=

# https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Utility template in Meta, language English. Body:
# {{1}}, five days ago this looked like {{2}}. Send a daylight photo of that same leaf, and reply better, worse, or the same.
WHATSAPP_CHECKBACK_TEMPLATE=crop_checkback
